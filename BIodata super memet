<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Pribadi - Rahmat Hidayat</title>
    
    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
            font-family: 'Rajdhani', sans-serif; 
        }
        
        body { 
            /* Tema Biru Tua & Putih Robotik */
            background-color: #0b132b; 
            background-image: linear-gradient(rgba(11, 19, 43, 0.92), rgba(5, 10, 24, 0.95)), radial-gradient(circle at 50% 20%, rgba(0, 180, 216, 0.15) 0%, transparent 60%); 
            background-size: cover; 
            background-attachment: fixed; 
            color: #e0fbfc; 
            line-height: 1.6; 
        }
        
        .container { 
            max-width: 800px; 
            margin: 40px auto; 
            padding: 20px; 
        }
        
        /* Desain Header / Hero Section Robotik Elegan */
        .hero { 
            background: linear-gradient(135deg, #1c2541, #0b132b); 
            color: #ffffff; 
            text-align: center; 
            padding: 50px 20px; 
            border-radius: 12px 12px 0 0; 
            border: 1px solid rgba(0, 180, 216, 0.4); 
            box-shadow: 0 0 25px rgba(0, 180, 216, 0.15); 
            position: relative; 
        }
        
        /* Garis Neon Pemisah Ala Sci-Fi */
        .hero::after { 
            content: ''; 
            position: absolute; 
            bottom: 0; 
            left: 15%; 
            width: 70%; 
            height: 2px; 
            background: linear-gradient(90deg, transparent, #00b4d8, transparent); 
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            letter-spacing: 2px;
            color: #00b4d8;
            text-shadow: 0 0 10px rgba(0, 180, 216, 0.5);
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 1.2rem;
            color: #a5a1ff;
            font-style: italic;
        }

        /* Konten Utama */
        .content {
            background: rgba(28, 37, 65, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 180, 216, 0.2);
            border-top: none;
            border-radius: 0 0 12px 12px;
            padding: 40px 30px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.4rem;
            color: #00b4d8;
            margin-bottom: 15px;
            border-left: 4px solid #00b4d8;
            padding-left: 10px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .info-item {
            background: rgba(11, 19, 43, 0.5);
            padding: 15px;
            border-radius: 6px;
            border: 1px solid rgba(224, 251, 252, 0.1);
        }

        .info-item label {
            display: block;
            font-size: 0.9rem;
            color: #a5a1ff;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .info-item value {
            display: block;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .social-btn {
            display: inline-block;
            margin-top: 10px;
            padding: 10px 20px;
            background: transparent;
            color: #00b4d8;
            border: 1px solid #00b4d8;
            border-radius: 4px;
            text-decoration: none;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .social-btn:hover {
            background: #00b4d8;
            color: #0b132b;
            box-shadow: 0 0 15px rgba(0, 180, 216, 0.4);
        }

        @media (max-width: 600px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HERO SECTION -->
        <div class="hero">
            <h1>RAHMAT HIDAYAT</h1>
            <p>"Berjalan pelan tetap lebih baik daripada diam karena takut salah"</p>
        </div>

        <!-- CONTENT SECTION -->
        <div class="content">
            <!-- BIODATA -->
            <div class="section">
                <h2>Data Pribadi</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <label>Nama Panggilan</label>
                        <value>Memet</value>
                    </div>
                    <div class="info-item">
                        <label>Tempat, Tanggal Lahir</label>
                        <value>Soraya, 23 April 2010</value>
                    </div>
                    <div class="info-item" style="grid-column: span 2;">
                        <label>Alamat Sekarang</label>
                        <value>Jl. Serdam, Komplek Korpri Blok 2 No. 13</value>
                    </div>
                </div>
            </div>

            <!-- HOBI & KEMAMPUAN -->
            <div class="section">
                <h2>Hobi & Keahlian</h2>
                <div class="info-grid">
                    <div class="info-item">
                        <label>Aktivitas Utama</label>
                        <value>Memasak</value>
                    </div>
                    <div class="info-item">
                        <label>Keahlian Teknis</label>
                        <value>Coding</value>
                    </div>
                </div>
            </div>

            <!-- MEDIA SOSIAL -->
            <div class="section">
                <h2>Hubungi Saya</h2>
                <a href="https://instagram.com" target="_blank" class="social-btn">
                    IG: @kedondongpftt
                </a>
            </div>
        </div>
    </div>

</body>
</html>
